desktop/data.db*
desktop/_tb_login_profile/
desktop/smoke-tmp/
desktop/test-tmp*/
desktop/rules-tmp/
desktop/shell-tmp/

# ===== 构建产物 =====
desktop/build/
desktop/dist/
releases/
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/capture/

